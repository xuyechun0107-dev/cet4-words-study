[Unit]
Description=Generate the complete Enplay recorded-audio library
Wants=network-online.target
After=network-online.target enplay-api.service
Requires=enplay-api.service
StartLimitIntervalSec=86400
StartLimitBurst=3

[Service]
Type=oneshot
User=enplay
Group=enplay
WorkingDirectory=/opt/enplay/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OMP_WAIT_POLICY=PASSIVE
Environment=XDG_CACHE_HOME=/opt/enplay/shared/tts-cache
UMask=0027
ExecStartPre=/usr/bin/test -x /opt/enplay/venv/bin/python
ExecStartPre=/usr/bin/test -r /opt/enplay/current/generate_recorded_audio.py
ExecStartPre=/usr/bin/test -r /opt/enplay/shared/models/kokoro-v1.0.fp16.onnx
ExecStartPre=/usr/bin/test -r /opt/enplay/shared/models/voices-v1.0.bin
ExecStartPre=/usr/bin/test -d /opt/enplay/shared/audio-build-v1
ExecStartPre=/usr/bin/test -d /opt/enplay/shared/tts-cache
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 30 --retry-delay 1 --retry-connrefused http://127.0.0.1:28100/health
ExecStart=/opt/enplay/venv/bin/python /opt/enplay/current/generate_recorded_audio.py --workspace /opt/enplay/current --model /opt/enplay/shared/models/kokoro-v1.0.fp16.onnx --voices-file /opt/enplay/shared/models/voices-v1.0.bin --output /opt/enplay/shared/audio-build-v1 --api-base http://127.0.0.1:28100 --source-mode all --progress-every 100 --voices af_heart af_bella bf_emma am_michael bm_george
Restart=on-failure
RestartSec=60s
TimeoutStartSec=infinity
TimeoutStopSec=60s
CPUQuota=200%
Nice=10
MemoryMax=2500M
OOMPolicy=stop
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/enplay/shared/audio-build-v1 /opt/enplay/shared/tts-cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
TasksMax=256
LimitNOFILE=4096
